# auto uses OpenAI when OPENAI_API_KEY is set, otherwise the local Hugging Face model.
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LOCAL_MODEL=HuggingFaceTB/SmolLM2-135M-Instruct
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=4
SEARCH_TYPE=mmr
SCORE_THRESHOLD=0
